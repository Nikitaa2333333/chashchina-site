---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Заявка отправлена — Оксана Чащина">
  <Header />
  <section class="section">
    <div class="container">
      <p class="tag reveal">Запись</p>
      <h1 data-split>Заявка отправлена</h1>
      <p class="lead reveal">
        Спасибо. Я или мой помощник свяжемся с вами в ближайшее время.
        Если вопрос срочный — можно позвонить напрямую.
      </p>
      <p class="reveal"><a class="link-arrow" href="/">На главную →</a></p>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  h1 { margin-block: 14px var(--block-gap); }
</style>
