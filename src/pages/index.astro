---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/asset';

const steps = [
  {
    title: 'Разобраться',
    text: 'Сначала нужно понять, с чем мы имеем дело. Тип старения у всех разный, и от него напрямую зависит, что делать можно, а что бессмысленно или даже вредно. Иногда для этого достаточно осмотра, иногда я прошу сдать анализы: часть проблем с кожей решается не в кабинете косметолога.',
  },
  {
    title: 'Подготовить ткани',
    text: 'Радиоволновой лифтинг, микротоки, процедуры с очищающим действием — они оздоравливают ткани и сосуды, выводят лишнюю жидкость, возвращают коже плотность и сияние.',
  },
  {
    title: 'Подтянуть и закрепить',
    text: 'И только когда ткани к этому готовы, есть смысл переходить к мощному лифтингу и закреплять достигнутый результат. В обратном порядке это или не даст эффекта, или даст, но ненадолго.',
  },
];

const values = [
  { t: 'Безопасность технологии', d: 'И для пациента, и для врача — это не обсуждается.' },
  { t: 'Предсказуемость результата', d: 'Я должна понимать, что именно получится и через какое время, и сказать это вам до начала, а не после.' },
  { t: 'Ваше участие', d: 'Косметология не работает в отрыве от чекапов, сна, физической нагрузки и управления стрессом. Это не дополнение к процедурам, это их условие.' },
];

const hardware = [
  {
    t: 'Световые и лазерные методики',
    d: 'Работают адресно: пигмент, сосуды, неровный рельеф. Выравнивают тон и запускают выработку нового коллагена.',
  },
  {
    t: 'Радиоволновой лифтинг',
    d: 'Мягкий прогрев тканей, от которого кожа плотнеет и уходит отёчность. Результат нарастает постепенно и выглядит естественно.',
  },
  {
    t: 'Токи и микротоки',
    d: 'Возвращают тонус мышцам и сосудам, разгоняют лимфу. Деликатная работа без боли и реабилитации — лицо просыпается.',
  },
  {
    t: 'Фокусированный ультразвук',
    d: 'Работает на глубине SMAS — слоя, на котором держится овал лица. Подтяжка каркаса без разрезов и наркоза.',
  },
];

const injTasks = [
  {
    t: 'Качество и увлажнённость кожи',
    d: 'Вернуть плотность, сияние и способность держать влагу, когда кожа выглядит уставшей. Препарат подбирается под состояние кожи, а не по моде.',
  },
  {
    t: 'Объёмы и опора тканей',
    d: 'С возрастом лицо теряет объём в точках опоры — щёки, виски, подбородок. Восполняем его точечно, ориентир — ваше лицо, а не шаблон.',
  },
  {
    t: 'Мимические зоны',
    d: 'Лоб, межбровье, уголки глаз. Расслабить мышцу ровно настолько, чтобы морщина смягчилась, а мимика осталась живой.',
  },
  {
    t: 'Асимметрия',
    d: 'Асимметрия есть у всех. Когда она начинает бросаться в глаза — аккуратно сгладить так, чтобы вмешательство осталось незаметным.',
  },
];

const zones = ['Шея и кольца Венеры', 'Второй подбородок', 'Кисти, локти, колени'];

const homecare = [
  'Компоненты, которые работают',
  'Компоненты, которых лучше избегать',
  'Домашние гаджеты: где эффект, а где игрушка',
];

const press = [
  { src: 'РБК', t: 'Когда лучше принимать коллаген' },
  { src: 'ТАСС', t: 'Утренние отёки и повышенный кортизол' },
  { src: 'Газета.ру', t: 'Компоненты косметики, которых лучше избегать' },
  { src: 'Flacon', t: 'Как работает SMAS-лифтинг' },
  { src: 'U Magazine', t: 'Устаревшие процедуры и что пришло им на замену' },
  { src: 'Beautyhack', t: 'Wellness-манифест 2026' },
];

const rubrics = [
  'Кожа и внутренние процессы',
  'Питание и долголетие',
  'Разбор ингредиентов',
  'Уход: правила и мифы',
  'Токсическая нагрузка',
  'Разбор процедур и методов',
];

const symptoms = [
  'Перепробовали десяток уходов, а высыпания всё равно возвращаются.',
  'Кожа выглядит тусклой и уставшей, хотя объективно ничего не случилось.',
  'Утром лицо отекает, и вы уже не знаете, на что грешить.',
  'После лета появились пятна, которые не уходят сами.',
  'Лицо ещё держится, а шея и руки выдают возраст.',
  'Хочется подтянуть — но страшно получить чужое лицо вместо своего.',
];

const path = [
  { y: '1997', t: 'СибГМУ, лечебный факультет — начало пути в медицине' },
  { y: '2002', t: 'МГМСУ, «Лечебное дело»' },
  { y: '2004', t: 'Ординатура по дерматовенерологии в РМАПО. Первые годы практики врачом-косметологом' },
  { y: '2011', t: 'Интернатура по хирургии, переподготовка по косметологии. Заведующая отделением эстетики тела в клинике антиэйджинга' },
  { y: '2013', t: 'Физиотерапия — ИППО ФМБЦ им. Бурназяна' },
  { y: '2018', t: 'Сеть клиник превентивной медицины «Атлас»' },
  { y: '2021', t: '«Олимп Клиник», затем возвращение в «Атлас»' },
  { y: '2022', t: 'Организация здравоохранения и общественное здоровье' },
  { y: 'Сегодня', t: 'Ассоциации косметологов и мезотерапевтов, эстетической медицины ЦВЕ, PreventAge' },
];
---

<Layout
  title="Оксана Чащина — врач-косметолог, специалист превентивной медицины"
  description="Врач-косметолог с опытом 22 года. Аппаратные и инъекционные методы, работа с кожей и с внутренними причинами её состояния. Запись на консультацию."
>
  <Header />

  <!-- ============ 1. Первый экран ============
       Слева текст, справа крупное фото; снизу фото — белый градиент,
       чтобы не было жёсткой границы со вторым блоком. -->
  <section class="section section--flush-top section--flush-bottom hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="tag reveal">Приём в Москве · аппаратные и инъекционные методы</p>
        <h1 class="display" data-split>Оксана Чащина</h1>
        <p class="hero__role reveal" style="--reveal-delay:.12s">
          Врач-косметолог, специалист превентивной медицины. 22 года практики.
        </p>
        <p class="lead reveal" style="--reveal-delay:.18s">
          Аппарат сам по себе не решает ничего. Решает то, насколько точно
          понятно, что происходит с вашей кожей — и с организмом, частью
          которого она является.
        </p>
        <div class="hero__cta reveal" style="--reveal-delay:.24s">
          <a href="#booking" class="btn">Записаться на консультацию</a>
          <p class="small hero__note">Консультация — 60 минут</p>
        </div>
      </div>

      <figure class="hero__photo">
        <img
          src={asset('photos/hero.png')}
          alt="Оксана Чащина — врач-косметолог"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- ============ Галерея (приём из prmpt: скейл карточек от скролла) ============ -->
  <Gallery />

  <!-- ============ 2. С чем приходят ============ -->
  <section class="section" id="work">
    <div class="container">
      <p class="tag reveal">С чем приходят</p>
      <h2 data-split>Возможно, вам это знакомо</h2>
      <ul class="cards reveal-group">
        {symptoms.map((text, i) => (
          <li class="cards__item">
            <span class="tag cards__num">{String(i + 1).padStart(2, '0')}</span>
            <p>{text}</p>
          </li>
        ))}
      </ul>
      <p class="reveal">
        Если узнали себя <mark>хотя бы в одном пункте</mark> — дальше о том,
        как я с этим работаю.
      </p>
    </div>
  </section>

  <!-- ============ 3. Работа с двух сторон ============
       Общий заголовок + контрастный сплит: светлая и шалфейная половины -->
  <section id="halves">
    <div class="container halves-head">
      <p class="tag reveal">Из чего складывается результат</p>
      <h2 data-split>Работа идёт с&nbsp;двух сторон</h2>
      <p class="lead reveal">
        Процедуры — только половина дела. Вторая половина — то, что
        происходит внутри организма: от&nbsp;него зависит, каким будет
        эффект и&nbsp;как долго он&nbsp;продержится.
      </p>
    </div>
    <div class="halves-split">
      <div class="halves-split__col halves-split__col--light">
        <div class="halves-split__inner">
          <p class="tag reveal">01</p>
          <h3 class="halves-split__title" data-split>Снаружи</h3>
          <p class="reveal">
            Лазеры, фокусированный ультразвук, радиоволновой лифтинг, токи.
            Всё, что делается с кожей и мягкими тканями непосредственно —
            с понятной глубиной воздействия и предсказуемым результатом.
          </p>
        </div>
      </div>
      <div class="halves-split__col halves-split__col--sage">
        <video
          class="halves-split__video"
          src={asset('video/serum.mp4')}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
        <div class="halves-split__inner">
          <p class="tag reveal">02</p>
          <h3 class="halves-split__title" data-split>Изнутри</h3>
          <p class="reveal">
            Хроническое воспаление, окислительный стресс, гликация, дефициты,
            качество сна. Всё, из-за чего кожа стареет быстрее и хуже
            восстанавливается — и что не исправить ни одним аппаратом.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Тёмная контрастная секция (реф: hero croptab на глубоком олива) -->
  <section class="section theme-dark">
    <div class="container">
      <p class="tag reveal">Два механизма, о которых редко говорят</p>
      <div class="mechanisms reveal-group">
        <div class="mechanisms__item">
          <h3>Инфламэйджинг</h3>
          <p>
            Старение через хроническое воспаление. Оно может быть незаметным,
            но при этом годами поддерживать высыпания, замедлять восстановление
            и разрушать коллаген.
          </p>
        </div>
        <div class="mechanisms__item">
          <h3>Гликация</h3>
          <p>
            Повреждение белков избытком сахара. Именно из-за неё коллаген
            теряет эластичность, а кожа — упругость, независимо от того,
            что вы наносите сверху.
          </p>
        </div>
      </div>
      <hr class="rule mechanisms__rule" />
      <p class="lead reveal">
        Кожа — самый большой орган человека. Работая с ней, мы включаем
        процессы и в окружающих тканях. Поэтому антивозрастная работа — это
        работа с организмом целиком, а не с отдельной морщиной.
      </p>
    </div>
  </section>

  <!-- ============ 4. Как строится работа ============ -->
  <section class="section" id="steps">
    <div class="container">
      <p class="tag reveal">Как строится работа</p>
      <h2 data-split>Почему я не начинаю с лифтинга</h2>
      <div class="spec reveal-group">
        {steps.map((s, i) => (
          <div class="spec__row">
            <span class="tag">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <p class="tag spec__sub reveal">Что для меня важно</p>
      <div class="triple reveal-group">
        {values.map((v) => (
          <div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Фото-пауза: во всю ширину экрана -->
  <figure class="strip">
    <img src={asset('photos/web/strip1.webp')} alt="Оксана Чащина на приёме" loading="lazy" decoding="async" />
    <figcaption class="strip__cap">
      <span>
        Процедуры работают, когда понятна причина. Тип старения у всех
        разный, и то, что помогло подруге, вам может просто не подойти.
      </span>
      <span>
        Поэтому приём начинается с разговора и осмотра, а не с аппарата.
        Иногда — с анализов: часть проблем с кожей решается не в кабинете
        косметолога.
      </span>
    </figcaption>
  </figure>

  <!-- ============ 5. Аппаратные методы ============ -->
  <!-- Процедурный трек («снаружи») — розовая плашка и розовые бирки -->
  <section class="section section--rose accent-rose" id="methods">
    <div class="container">
      <p class="tag reveal">Аппаратные методы</p>
      <h2 data-split>Что происходит с тканями</h2>
      <p class="lead reveal">
        Ниже — не перечень аппаратов, а объяснение того, что каждый метод
        делает с кожей. Торговые названия имеет смысл обсуждать уже
        на консультации, когда понятна задача.
      </p>
      <div class="passport passport--bento reveal-group">
        {hardware.map((h, i) => (
          i === 3 ? (
            <div class="passport__card passport__card--feature">
              <div class="passport__feature-text">
                <span class="tag">0{i + 1}</span>
                <div class="passport__body">
                  <h3>{h.t}</h3>
                  <p class="passport__desc">{h.d}</p>
                </div>
              </div>
              <video
                class="passport__video"
                src={asset('video/ripple.mp4')}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-hidden="true"
              ></video>
            </div>
          ) : (
            <div class="passport__card">
              <span class="tag">0{i + 1}</span>
              <div class="passport__body">
                <h3>{h.t}</h3>
                <p class="passport__desc">{h.d}</p>
              </div>
            </div>
          )
        ))}
      </div>
      <div class="quit reveal">
        <h3>Чего я больше не делаю</h3>
        <p>
          Косметология меняется быстро, и часть процедур, популярных десять лет
          назад, сегодня либо неэффективна, либо вытеснена более безопасными
          методами. Я о них рассказываю честно — в том числе о тех, что мне
          самой когда-то нравились.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ 6. Гравитационный птоз и SMAS ============ -->
  <section class="section" id="smas">
    <div class="container split">
      <div>
        <p class="tag reveal">Гравитационный птоз</p>
        <h2 data-split>Что можно сделать с овалом</h2>
        <p class="reveal">
          С возрастом провисает не столько кожа, сколько то, на чём она
          держится — внутренний каркас лица. Поэтому кремы и поверхностные
          процедуры на овал почти не влияют: они работают выше, а проблема
          глубже.
        </p>
      </div>
      <figure class="split__photo reveal">
        <img src={asset('photos/web/09.webp')} alt="Оксана Чащина" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <!-- ============ 7. Инъекционные методы ============ -->
  <!-- Процедурный трек («снаружи») — розовая плашка и розовые бирки -->
  <section class="section section--rose accent-rose" id="injections">
    <div class="container">
      <p class="tag reveal">Инъекционные методы</p>
      <h2 data-split>Чего можно достичь</h2>
      <p class="lead reveal">
        Говорю не о препаратах, а о задачах. Препарат подбирается под задачу,
        а не наоборот.
      </p>
      <div class="passport reveal-group">
        {injTasks.map((t, i) => (
          <div class="passport__card">
            <span class="tag">0{i + 1}</span>
            <div class="passport__body">
              <h3>{t.t}</h3>
              <p class="passport__desc">{t.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 8. Зоны, которые выдают возраст ============ -->
  <!-- Процедурный трек («снаружи») — белый фон, розовые бирки -->
  <section class="section accent-rose" id="zones">
    <div class="container">
      <p class="tag reveal">Зоны, которые выдают возраст</p>
      <h2 data-split>Лицо ещё держится, а шея выдаёт</h2>
      <p class="lead reveal">
        Возраст читается не по лбу и не по носогубным складкам. Первыми выдают
        шея, зона декольте, кисти рук — и именно им обычно достаётся меньше
        всего внимания.
      </p>
      <ul class="zones reveal-group">
        {zones.map((z) => (
          <li>
            <h3>{z}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 9. Красота начинается не с крема ============ -->
  <section class="section theme-dark" id="inside">
    <div class="container">
      <p class="tag reveal">Про внутреннее</p>
      <p class="manifesto reveal">
        Красота начинается <mark>не с крема</mark>
      </p>
      <div class="manifesto__cols reveal-group">
        <p>
          Состояние кожи во многом определяется тем, что происходит внутри.
          Хроническое воспаление, окислительный стресс, состояние кишечника,
          дефициты, качество сна — всё это отражается на лице раньше, чем
          мы связываем одно с другим.
        </p>
        <p>
          Я не верю в одну молекулу, которая решит все проблемы. Красивая
          кожа — это всегда результат комплексной работы: домашнего ухода,
          процедур по показаниям, питания, образа жизни и здоровья организма
          в целом.
        </p>
      </div>
      <a class="link-arrow reveal" href="#articles">Читать статьи →</a>
    </div>
  </section>

  <!-- ============ 10. Домашний уход ============ -->
  <!-- Уход — тоже внешняя линия: розовые бирки -->
  <section class="section accent-rose" id="homecare">
    <div class="container split split--reverse">
      <figure class="split__photo reveal">
        <img src={asset('photos/web/07.webp')} alt="Оксана Чащина" loading="lazy" decoding="async" />
      </figure>
      <div>
        <p class="tag reveal">Домашний уход</p>
        <h2 data-split>Что действительно работает дома</h2>
        <p class="reveal">
          Домашний уход иногда решает больше, чем процедуры. Но вокруг него
          столько маркетинга, что разобраться самостоятельно почти невозможно.
        </p>
        <ul class="list-plain reveal-group">
          {homecare.map((h) => (
            <li>
              <h3>{h}</h3>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 12–13. Соцсети и СМИ ============ -->
  <section class="section section--surface" id="press">
    <div class="container">
      <p class="tag reveal">Публикации в СМИ</p>
      <h2 data-split>Меня спрашивают</h2>
      <p class="lead reveal">
