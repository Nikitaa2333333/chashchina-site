---
// Каркас футера: полоса-примечание + служебная строка.
// Оформление снято вместе со старым дизайном.
import { asset } from '../lib/asset';
---

<footer class="footer">
  <div class="footer__note">
    <div class="container">
      <p>Имеются противопоказания. Необходима консультация специалиста.</p>
    </div>
  </div>
  <div class="container footer__row">
    <p>Оксана Чащина, {new Date().getFullYear()}</p>
    <nav class="footer__links">
      <a href="https://t.me/krasotanasspaset">Telegram</a>
      <a href="https://vk.com/krasotanasspaset">ВКонтакте</a>
      <a href="https://dzen.ru/id/6237172c60d2e66b912c755f">Дзен</a>
    </nav>
    <a href={asset('policy')}>Политика обработки персональных данных</a>
  </div>
</footer>

<style>
  .footer__note { padding-block: 22px; }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    padding-block: 22px;
  }
  .footer__links {
    display: flex;
    gap: 24px;
  }
  @media (max-width: 700px) {
    .footer__row { flex-direction: column; align-items: flex-start; }
  }
</style>
